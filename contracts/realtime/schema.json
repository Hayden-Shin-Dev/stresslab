{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "실시간 시세 입력과 시장 상태 출력",
  "description": "record_type으로 수집 입력과 Fabric 출력을 구분합니다. 한 메시지에 한 이벤트 또는 스냅샷을 전달합니다.",
  "oneOf": [
    {
      "$ref": "#/$defs/quote_event"
    },
    {
      "$ref": "#/$defs/market_risk_snapshot"
    },
    {
      "$ref": "#/$defs/market_state_snapshot"
    }
  ],
  "$defs": {
    "quote_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "event_id",
        "asset_id",
        "instrument_kind",
        "source",
        "event_time",
        "received_at",
        "price",
        "cumulative_volume",
        "trade_volume",
        "venue",
        "session",
        "date_inferred",
        "is_mock"
      ],
      "properties": {
        "record_type": {
          "const": "quote_event"
        },
        "schema_version": {
          "const": "1.0"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "description": "재전송 시 유지되는 수집기 ID"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "description": ""
        },
        "instrument_kind": {
          "type": "string",
          "minLength": 1,
          "description": "",
          "enum": [
            "stock",
            "index",
            "sector_etf"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "",
          "enum": [
            "kiwoom_websocket",
            "kiwoom_rest"
          ]
        },
        "event_time": {
          "type": [
            "string",
            "null"
          ],
          "description": "공급자 관측 시각. REST 수신시각으로 대체하지 않습니다.",
          "format": "date-time",
          "pattern": "Z$"
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "price": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cumulative_volume": {
          "type": [
            "number",
            "null"
          ],
          "description": "세션 누적 거래량, 주",
          "minimum": 0
        },
        "trade_volume": {
          "type": [
            "number",
            "null"
          ],
          "description": "해당 체결량, 주. REST는 NULL",
          "minimum": 0
        },
        "venue": {
          "type": "string",
          "minLength": 1,
          "description": "",
          "enum": [
            "KRX",
            "NXT",
            "UNKNOWN"
          ]
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "description": "",
          "enum": [
            "regular",
            "auction",
            "afterhours",
            "unknown"
          ]
        },
        "date_inferred": {
          "type": "boolean"
        },
        "is_mock": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "kiwoom_rest"
              }
            }
          },
          "then": {
            "properties": {
              "trade_volume": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "market_risk_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "snapshot_id",
        "as_of",
        "computed_at",
        "last_event_time",
        "window_start",
        "universe_id",
        "expected_asset_count",
        "valid_asset_count",
        "declining_asset_count",
        "declining_ratio",
        "quality_status",
        "connection_status",
        "feature_version",
        "daily_state_date",
        "is_mock",
        "assets",
        "sectors"
      ],
      "properties": {
        "record_type": {
          "const": "market_risk_snapshot"
        },
        "schema_version": {
          "const": "1.0"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "description": ""
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "computed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "last_event_time": {
          "type": [
            "string",
            "null"
          ],
          "description": "집계에 사용한 최신 유효 공급자 시각",
          "format": "date-time",
          "pattern": "Z$"
        },
        "window_start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "universe_id": {
          "type": "string",
          "minLength": 1,
          "description": "관측 종목 목록과 구성 버전"
        },
        "expected_asset_count": {
          "type": "integer",
          "minimum": 1
        },
        "valid_asset_count": {
          "type": "integer",
          "minimum": 0
        },
        "declining_asset_count": {
          "type": "integer",
          "minimum": 0
        },
        "declining_ratio": {
          "type": [
            "number",
            "null"
          ],
          "description": "유효 종목 중 5분 수익률이 음수인 비율, 0~1",
          "minimum": 0,
          "maximum": 1
        },
        "quality_status": {
          "type": "string",
          "minLength": 1,
          "description": "",
          "enum": [
            "valid",
            "partial",
            "stale",
            "market_closed",
            "unverified"
          ]
        },
        "connection_status": {
          "type": "string",
          "minLength": 1,
          "description": "",
          "enum": [
            "connected",
            "disconnected",
            "reconnecting",
            "unknown"
          ]
        },
        "feature_version": {
          "type": "string",
          "minLength": 1,
          "description": ""
        },
        "daily_state_date": {
          "type": "string",
          "format": "date"
        },
        "is_mock": {
          "type": "boolean"
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "return_since_previous_close_pct",
              "return_5m_pct",
              "volatility_30m_pct",
              "volume_since_open",
              "volume_vs_same_time_ratio"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1,
                "description": ""
              },
              "return_since_previous_close_pct": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "전일 확정 종가 대비 현재가 변화율 %"
              },
              "return_5m_pct": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "완료된 분봉의 5분 수익률 %"
              },
              "volatility_30m_pct": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "최근 30개 1분 로그수익률의 표본 표준편차 %, 연율화하지 않음",
                "minimum": 0
              },
              "volume_since_open": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "검증된 세션 누적 거래량, 주",
                "minimum": 0
              },
              "volume_vs_same_time_ratio": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "같은 시각 과거 비교가 검증된 경우만 제공",
                "minimum": 0
              }
            }
          }
        },
        "sectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sector_id",
              "valid_asset_count",
              "declining_asset_count",
              "declining_ratio"
            ],
            "properties": {
              "sector_id": {
                "type": "string",
                "minLength": 1,
                "description": ""
              },
              "valid_asset_count": {
                "type": "integer",
                "minimum": 0
              },
              "declining_asset_count": {
                "type": "integer",
                "minimum": 0
              },
              "declining_ratio": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "같은 업종의 유효 종목 중 하락 종목 비율",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "market_state_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "as_of",
        "computed_at",
        "window_start",
        "last_event_time",
        "last_completed_bar_end",
        "universe_id",
        "whole_kospi",
        "quality_status",
        "session_verified",
        "market_phase",
        "connection_status",
        "source",
        "feature_version",
        "is_mock",
        "expected_asset_count",
        "valid_asset_count",
        "declining_asset_count",
        "declining_ratio",
        "market",
        "assets",
        "sectors",
        "signals",
        "signal_policy",
        "applied_to_daily_ml",
        "limitations",
        "snapshot_id",
        "daily_state_date"
      ],
      "properties": {
        "record_type": {
          "const": "market_state_snapshot"
        },
        "schema_version": {
          "const": "2.0"
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "computed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "window_start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "last_event_time": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "last_completed_bar_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "universe_id": {
          "type": "string"
        },
        "whole_kospi": {
          "type": "boolean"
        },
        "quality_status": {
          "enum": [
            "valid",
            "partial",
            "stale",
            "unverified"
          ]
        },
        "session_verified": {
          "type": "boolean"
        },
        "market_phase": {
          "type": "string"
        },
        "connection_status": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "feature_version": {
          "type": "string"
        },
        "is_mock": {
          "type": "boolean"
        },
        "expected_asset_count": {
          "type": "integer",
          "minimum": 0
        },
        "valid_asset_count": {
          "type": "integer",
          "minimum": 0
        },
        "declining_asset_count": {
          "type": "integer",
          "minimum": 0
        },
        "declining_ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "market": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_asset_count",
            "valid_asset_count",
            "declining_asset_count",
            "declining_ratio",
            "mean_return_5m_pct",
            "mean_return_since_previous_close_pct",
            "previous_close_coverage",
            "mean_return_since_open_pct",
            "open_price_coverage",
            "recent_direction",
            "mean_correlation_60m",
            "correlation_asset_count",
            "joint_down_ratio_60m",
            "joint_down_valid_minutes",
            "sector_classification_coverage"
          ],
          "properties": {
            "expected_asset_count": {
              "type": "integer",
              "minimum": 0
            },
            "valid_asset_count": {
              "type": "integer",
              "minimum": 0
            },
            "declining_asset_count": {
              "type": "integer",
              "minimum": 0
            },
            "declining_ratio": {
              "type": [
                "number",
                "null"
              ]
            },
            "mean_return_5m_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "mean_return_since_previous_close_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "previous_close_coverage": {
              "type": [
                "number",
                "null"
              ]
            },
            "mean_return_since_open_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "open_price_coverage": {
              "type": [
                "number",
                "null"
              ]
            },
            "recent_direction": {
              "type": "string"
            },
            "mean_correlation_60m": {
              "type": [
                "number",
                "null"
              ]
            },
            "correlation_asset_count": {
              "type": "integer",
              "minimum": 0
            },
            "joint_down_ratio_60m": {
              "type": [
                "number",
                "null"
              ]
            },
            "joint_down_valid_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "sector_classification_coverage": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "return_since_previous_close_pct",
              "return_since_open_pct",
              "return_since_first_minute_pct",
              "return_5m_pct",
              "volatility_30m_pct",
              "realized_volatility_since_open_pct",
              "volume_since_open",
              "observed_volume",
              "volume_vs_same_time_ratio",
              "volatility_vs_same_time_ratio",
              "minutes_expected",
              "minutes_observed",
              "complete_since_open",
              "baseline_days",
              "sector_id"
            ],
            "properties": {
              "asset_id": {
                "type": "string"
              },
              "return_since_previous_close_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "return_since_open_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "return_since_first_minute_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "return_5m_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "volatility_30m_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "realized_volatility_since_open_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "volume_since_open": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "observed_volume": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "volume_vs_same_time_ratio": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "volatility_vs_same_time_ratio": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "minutes_expected": {
                "type": "integer",
                "minimum": 0
              },
              "minutes_observed": {
                "type": "integer",
                "minimum": 0
              },
              "complete_since_open": {
                "type": "boolean"
              },
              "baseline_days": {
                "type": "integer",
                "minimum": 0
              },
              "sector_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "sectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sector_id",
              "expected_asset_count",
              "valid_asset_count",
              "declining_asset_count",
              "declining_ratio",
              "mean_return_5m_pct",
              "mean_return_since_previous_close_pct",
              "previous_close_coverage",
              "mean_return_since_open_pct",
              "open_price_coverage",
              "recent_direction"
            ],
            "properties": {
              "sector_id": {
                "type": "string"
              },
              "expected_asset_count": {
                "type": "integer",
                "minimum": 0
              },
              "valid_asset_count": {
                "type": "integer",
                "minimum": 0
              },
              "declining_asset_count": {
                "type": "integer",
                "minimum": 0
              },
              "declining_ratio": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "mean_return_5m_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "mean_return_since_previous_close_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "previous_close_coverage": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "mean_return_since_open_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "open_price_coverage": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "recent_direction": {
                "type": "string"
              }
            }
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value",
              "threshold",
              "triggered",
              "status"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "threshold": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "triggered": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "signal_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rapid_drop_5m_pct",
            "declining_ratio",
            "volatility_vs_same_time_ratio",
            "minimum_coverage"
          ],
          "properties": {
            "rapid_drop_5m_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "declining_ratio": {
              "type": [
                "number",
                "null"
              ]
            },
            "volatility_vs_same_time_ratio": {
              "type": [
                "number",
                "null"
              ]
            },
            "minimum_coverage": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "applied_to_daily_ml": {
          "const": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "snapshot_id": {
          "type": "string"
        },
        "daily_state_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    }
  }
}
