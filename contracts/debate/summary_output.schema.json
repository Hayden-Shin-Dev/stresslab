{
  "type": "object",
  "properties": {
    "summary_text": {
      "type": "string",
      "description": "'결과'로 시작하는 최종 결론. 어떤 전문가의 근거로 결론 냈고, 어떤 반대가 있었고, 무엇으로 합의됐는지 3~4문장 240자 이내(숫자 나열 금지)"
    },
    "converged": {
      "type": "boolean",
      "description": "핵심 판단에 실질적인 반대가 남지 않았으면 true"
    },
    "open_issue_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "macro",
          "market",
          "risk",
          "portfolio"
        ],
        "description": "역할"
      },
      "description": "converged=false이고 3라운드가 가능할 때 다시 말할 쟁점 당사자. 아니면 빈 배열"
    },
    "accepted": {
