{
  "auth": {
    "identityProviders": {
      "google": {
        "registration": {
          "clientIdSettingName": "GOOGLE_CLIENT_ID",
          "clientSecretSettingName": "GOOGLE_CLIENT_SECRET"
        }
      }
    }
  },
  "routes": [
    {
      "route": "/",
      "rewrite": "/login.html"
    },
    {
      "route": "/index.html",
      "redirect": "/",
      "statusCode": 302
    },
    {
      "route": "/login",
      "rewrite": "/login.html"
    },
    {
      "route": "/dlsxmfh",
      "redirect": "/2_intro",
      "statusCode": 301
    },
    {
      "route": "/quote-monitor",
      "rewrite": "/quote-monitor/index.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/quote-monitor/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/quote-monito",
      "redirect": "/quote-monitor",
      "statusCode": 301
    },
    {
      "route": "/market.html",
      "redirect": "/quote-monitor",
      "statusCode": 301
    },
    {
      "route": "/holdings.html",
      "redirect": "/app/portfolio",
      "statusCode": 301
    },
    {
      "route": "/2_intro",
      "rewrite": "/2_intro/index.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/2_intro/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/app",
      "rewrite": "/whatif-agent.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/app/*",
      "rewrite": "/whatif-agent.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/whatif-agent.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "rewrite": "/login.html",
      "statusCode": 401
    }
  }
}
