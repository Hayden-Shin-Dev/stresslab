{
  "auth": {
    "identityProviders": {
      "google": {
        "registration": {
          "clientIdSettingName": "GOOGLE_CLIENT_ID",
          "clientSecretSettingName": "GOOGLE_CLIENT_SECRET"
        }
      }
    }
  },
  "routes": [
    {
      "route": "/",
      "redirect": "/quote-monitor",
      "statusCode": 302
    },
    {
      "route": "/index.html",
      "redirect": "/quote-monitor",
      "statusCode": 302
    },
    {
      "route": "/login",
      "rewrite": "/login.html"
    },
    {
      "route": "/holdings.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/quote-monitor",
      "rewrite": "/quote-monitor/index.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/quote-monitor/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/login.html",
      "statusCode": 302
    }
  }
}
