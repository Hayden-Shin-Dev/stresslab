{
  "auth": {
    "identityProviders": {
      "google": {
        "registration": {
          "clientIdSettingName": "GOOGLE_CLIENT_ID",
          "clientSecretSettingName": "GOOGLE_CLIENT_SECRET"
        }
      },
      "customOpenIdConnectProviders": {
        "entra": {
          "registration": {
            "clientIdSettingName": "ENTRA_CLIENT_ID",
            "clientCredential": {
              "clientSecretSettingName": "ENTRA_CLIENT_SECRET"
            },
            "openIdConnectConfiguration": {
              "wellKnownOpenIdConfiguration": "https://stresslabwhatif.ciamlogin.com/6cb3e872-62c9-46dd-92a1-3218ba9f5360/v2.0/.well-known/openid-configuration"
            }
          },
          "login": {
            "nameClaimType": "name",
            "scopes": [
              "openid",
              "profile",
              "email"
            ]
          }
        }
      }
    }
  },
  "routes": [
    {
      "route": "/",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/index.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/stress.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/holdings.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/login",
      "rewrite": "/login.html"
    },
    {
      "route": "/dlsxmfh",
      "redirect": "/2_intro",
      "statusCode": 301
    },
    {
      "route": "/quote-monitor",
      "rewrite": "/quote-monitor/index.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/quote-monitor/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/quote-monito",
      "redirect": "/quote-monitor",
      "statusCode": 301
    },
    {
      "route": "/market.html",
      "redirect": "/quote-monitor",
      "statusCode": 301
    },
    {
      "route": "/2_intro",
      "rewrite": "/2_intro/index.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/2_intro/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/app",
      "rewrite": "/whatif-agent.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/app/*",
      "rewrite": "/whatif-agent.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/whatif-agent.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/login.html",
      "statusCode": 302
    }
  }
}
