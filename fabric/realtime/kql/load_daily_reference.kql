// 전일 종가와 업종을 골드테이블에서 KQL 테이블로 옮깁니다.
// 언제: 골드 배치(Pl_batch_bronze to gold)가 끝난 뒤, 다음 장 시작(09:00 KST) 전 하루 한 번.
// 준비: eventhouse_whatif에 lh_whatif의 gold_stress_daily를 OneLake 바로 가기로 연결 (external_table 이름 gold_stress_daily).
// 명령이 두 개라 각각 따로 실행합니다(파이프라인 KQL 활동도 두 개).

.set-or-replace previous_close <|
    // 20종목 모두 같은 날짜(골드의 마지막 거래일) 하나만 씁니다. 종목마다 따로 최신 날짜를 고르면
    // 한 종목이 빠졌을 때 그 종목만 오래된 종가가 들어갑니다(2026-11-11 점검 지적).
    let src = external_table('gold_stress_daily')
        | where instrument_kind == "stock" and is_mock == false and quality_status == "valid"
        | where isnotnull(close) and close > 0 and trading_date < startofday(now() + 9h);
    let d = toscalar(src | summarize max(trading_date));
    src
    | where trading_date == d
    | project asset_id, trade_date = todatetime(trading_date), close = toreal(close), source = dataset_version

// 확인: n = 20, 날짜 하나(직전 거래일). 20이 아니면 골드 쪽 누락이니 배치 담당에게 알립니다.
// previous_close | summarize n = count(), dates = make_set(trade_date)

.set-or-replace asset_sector <|
    external_table('gold_stress_daily')
    | where instrument_kind == "stock" and is_mock == false and isnotempty(sector_id)
    | summarize arg_max(trading_date, sector_id, dataset_version) by asset_id
    | project asset_id, sector_id, source = dataset_version
