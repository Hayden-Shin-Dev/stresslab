// Fabric 파이프라인 pl_realtime_session의 bars_1m_append 활동 (매분)
// 최근 5분 완료 분봉을 다시 만들어 새로 생겼거나 값이 바뀐 행만 추가합니다(정정 이력).
.set-or-append bars_1m <|
    let t1 = bin(now() - 10s, 1m);
    let fresh = qe_bars(t1 - 5m, t1) | where bar_at < t1;
    let stored = bars_1m_latest()
        | where bar_at >= t1 - 5m
        | project asset_id, bar_at, s_open = open, s_high = high, s_low = low, s_close = close, s_volume = volume, s_ticks = ticks;
    fresh
    | join kind=leftouter stored on asset_id, bar_at
    | where isnull(s_close) or s_open != open or s_high != high or s_low != low or s_close != close or s_volume != volume or s_ticks != ticks
    | project asset_id, bar_at, open, high, low, close, volume, ticks, first_cum, last_cum, ingested_at = now()
